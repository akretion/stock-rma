<?xml version="1.0" ?>
<odoo>
    <record id="view_rma_form" model="ir.ui.view">
        <field name="model">rma.order</field>
        <field name="inherit_id" ref="rma.view_rma_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='rma_line_ids']/tree/field[@name='product_qty']"
                position="after"
            >
                <field
                    name="responsible_id"
                    optional="show"
                    options="{'no_open': True, 'no_create': True}"
                />
                <field name="cause_id_domain" invisible="1" />
                <field
                    name="cause_id"
                    attrs="{'invisible': [('responsible_id', '=', False)]}"
                    domain="cause_id_domain"
                    optional="show"
                    options="{'no_open': True, 'no_create': True}"
                />
            </xpath>
        </field>
    </record>
</odoo>
